{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "frontend/src",
    "tests/frontend/**/*.ts",
    "tests/frontend/**/*.tsx",
    "vite.config.ts"
  ]
}
